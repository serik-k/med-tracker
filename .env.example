# Copy this file to .env. Every required empty value below must be filled before
# Docker Compose can start. Keep .env outside Git and restrict it to deploy users.

# Docker / public entry point. Bind to loopback when a TLS reverse proxy runs
# on the same host. Use 0.0.0.0 only with an explicit firewall/network design.
COMPOSE_PROJECT_NAME=medtracker
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Runtime
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://medtracker.example.kz
# Two trusted hops match the documented chain: TLS edge proxy, then bundled
# frontend Nginx. Change this count with the topology and make sure the edge
# proxy replaces (rather than blindly appends) inbound X-Forwarded-* headers.
TRUST_PROXY=2
SHUTDOWN_TIMEOUT_MS=10000

# Initial accounts. Required by the production bootstrap. These values are
# used only when the database has no clinics; changing them later does not
# rotate existing account passwords.
SEED_PLATFORM_PASSWORD=
SEED_CLINIC_PASSWORD=
SEED_DISPATCHER_PASSWORD=

# PostgreSQL. Use URL-safe random values (for example: openssl rand -hex 32),
# because Docker Compose also places them inside PostgreSQL connection URLs.
POSTGRES_DB=medtracker
POSTGRES_USER=medtracker_owner
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# Access and retention windows. Expiry blocks access but is not a complete
# retention policy. Terminal calls remove the live access photo; records,
# audit logs and copies already present in backups remain separately managed.
SESSION_TTL_HOURS=24
DRIVER_TOKEN_TTL_DAYS=30
PATIENT_TOKEN_TTL_HOURS=72
CREW_LOCATION_MAX_AGE_MINUTES=30

# Request and abuse limits
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=50
ACCESS_LINK_RATE_LIMIT=30
PUBLIC_ACCESS_RATE_LIMIT=120
SOCKET_CONNECTION_RATE_LIMIT=60
SOCKET_JOIN_RATE_LIMIT=30
SOCKET_LOCATION_RATE_LIMIT=60
SOCKET_MUTATION_RATE_LIMIT=30
# Per patient capability, within the fixed five-minute upload window.
SOCKET_PHOTO_RATE_LIMIT=6
JSON_BODY_LIMIT=256kb
SOCKET_MAX_PAYLOAD_BYTES=1100000
MAX_ACCESS_PHOTO_BYTES=768000

# External geocoding/routing. Public community endpoints are suitable only for
# evaluation; choose providers with an SLA and approved data processing terms.
GEOCODING_TIMEOUT_MS=5000
GEOCODING_USER_AGENT="MedTracker/1.0 (ops@medtracker.example.kz)"
GEOCODING_BASE_URL=
ROUTING_TIMEOUT_MS=5000
OSRM_BASE_URL=

# Browser map tiles are fetched through the backend so patient/crew locations
# are not disclosed together with the end user's IP. The template must be an
# HTTP(S) URL containing literal {z}, {x} and {y} placeholders.
TILE_BASE_URL=
TILE_ATTRIBUTION=
TILE_TIMEOUT_MS=5000
MAX_TILE_BYTES=1048576
TILE_RATE_LIMIT=300
TILE_MAX_CONCURRENCY=16
TILE_MEMORY_CACHE_SECONDS=3600
TILE_MEMORY_CACHE_BYTES=33554432

# Simulation is development-only and remains disabled in production.
ENABLE_SIMULATION=false

# Docker paths. The medtracker-data volume persists uploaded access photos.
LEGACY_DB_DIR=/app/legacy-db
UPLOAD_DIR=/app/legacy-db/uploads

# For a non-Docker PostgreSQL run, export explicit URLs in the shell before
# starting the server. Docker Compose constructs internal URLs itself.
# DATABASE_URL=postgresql://medtracker_app:APP_PASSWORD@localhost:5432/medtracker
# DATABASE_ADMIN_URL=postgresql://medtracker_owner:OWNER_PASSWORD@localhost:5432/medtracker
