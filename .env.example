# MedTracker Production Environment Configuration
PORT=3001
NODE_ENV=production

# Public Domain / IP of your clinic server
DOMAIN=medtracker.clinic.kz

# CORS security setting for WebSockets
CORS_ORIGIN=https://medtracker.clinic.kz

# Initial accounts. Required in production on first launch.
SEED_PLATFORM_PASSWORD=change-this-platform-password
SEED_CLINIC_PASSWORD=change-this-clinic-password
SEED_DISPATCHER_PASSWORD=change-this-dispatcher-password

# PostgreSQL
POSTGRES_DB=medtracker
POSTGRES_USER=medtracker_owner
POSTGRES_PASSWORD=change-this-database-owner-password
POSTGRES_APP_PASSWORD=change-this-application-password
DATABASE_URL=postgresql://medtracker_app:change-this-application-password@localhost:5432/medtracker
DATABASE_ADMIN_URL=postgresql://medtracker_owner:change-this-database-owner-password@localhost:5432/medtracker
